# THE EYE — Environment Configuration
# Most values are empty — the system uses 100% free sources!

# Optional: Etherscan API key (free tier works without it, but higher rate limits with key)
ETHERSCAN_API_KEY=

# Optional: CoinGecko demo key (free, 500 calls/min vs 30 without)
COINGECKO_DEMO_KEY=

# Optional: Birdeye API key (free tier for Solana data)
BIRDEYE_API_KEY=

# Optional: Telegram Bot token (free from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Discord Webhook URL (free)
DISCORD_WEBHOOK_URL=

# Logging level
LOG_LEVEL=INFO
